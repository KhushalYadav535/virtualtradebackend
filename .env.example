PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://user:password@host:5433/dbname
REDIS_URL=redis://localhost:6379

# Demo users (optional — used by npm run seed:demo)
